# Copy to .env and fill in. .env is gitignored; this file is committed so a stranger can reproduce the repo.

# --- Required for pipelines B, C, D (single, rag, agents) ---
# Free key, no card: https://console.groq.com/keys
GROQ_API_KEY=

# Free-tier limits for llama-3.3-70b-versatile. Check yours at https://console.groq.com/settings/limits
# The client throttles itself to stay under RPM/TPM; the harness stops cleanly at RPD/TPD and resumes later.
GROQ_RPM=30
GROQ_TPM=12000
GROQ_RPD=1000
GROQ_TPD=100000

# --- Optional: dense retrieval via pgvector (Supabase or Neon free Postgres) ---
# Without it, RAG uses BM25 only (and results.json records that).
# Supabase: Project Settings -> Database -> Connection string (URI). Use the pooler URI on port 6543 if 5432 is blocked.
DATABASE_URL=

# --- Optional: tracing for the agent pipeline (Langfuse Cloud free tier) ---
# Local traces are always written into runs/agents.jsonl; Langfuse is the hosted waterfall view.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
